# Producció: DEBUG ha d'estar a False. Genera la clau amb:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=inventari.asixsapa.cat
CSRF_TRUSTED_ORIGINS=https://inventari.asixsapa.cat

# L'admin de Django (/admin/) està desactivat per defecte
DJANGO_ADMIN_ENABLED=False

# Límit d'intents de login fallits per IP i per usuari, i durada del bloqueig (s)
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_USER=20
LOGIN_LOCKOUT_SECONDS=900

# Google OAuth (opcional)
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=

# Base de dades: SQLite al volum /app/data (per defecte)
DATABASE_NAME=db.sqlite3

# Dies que es conserven les còpies de seguretat
BACKUP_KEEP_DAYS=30
